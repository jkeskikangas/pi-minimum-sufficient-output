{
  "name": "pi-minimum-sufficient-output",
  "version": "0.1.0",
  "description": "Minimum sufficient output for pi's transcript: one line per tool call, full output on ctrl+o.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "transcript",
    "renderer"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "author": "Jarno Keskikangas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkeskikangas/pi-minimum-sufficient-output.git"
  },
  "homepage": "https://github.com/jkeskikangas/pi-minimum-sufficient-output#readme",
  "bugs": {
    "url": "https://github.com/jkeskikangas/pi-minimum-sufficient-output/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
